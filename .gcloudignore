@"
# --- Secrets: never upload ---------------------------------------------
.env

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environment ----------------------------------------------------
venv/
.venv/
env/

# --- Copyrighted source material: not needed at build time, already ingested into chroma_db
rag/knowledge_base/*.pdf

# --- Test/debug artifacts ----------------------------------------------------
debug_*.png
debug_*.jpg

# --- IDE / OS ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Build/dist ---------------------------------------------------------
build/
dist/

# --- RAGAS eval working/debug artifacts ---------------------------------
evaluation/ragas_eval_generation_cache*.json
evaluation/ragas_eval_results_*.csv
evaluation/ragas_eval_results_*.md

# NOTE: rag/chroma_db/ and pipeline/student_model/checkpoints/*.pth are
# intentionally NOT excluded here (unlike .gitignore) - the Docker build
# needs both baked into the image. See Dockerfile checks.
"@ | Set-Content -Path .gcloudignore -Encoding UTF8