# Copy this file to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here          # dev/eval only (GPT-4o mini comparison)
MAIZE_API_KEY=choose_a_long_random_string_here    # shared key the Android app must send

# Local dev override only — in Cloud Run this is baked into the image, do not set to /tmp
CHROMA_PERSIST_DIR=./rag/chroma_db
